# Paste these values into the Zeabur APP service only after the private
# hostnames are visible in the Zeabur dashboard. Do not commit a filled copy.

APP_ENV=production
APP_BASE_URL=https://CHANGE_ME_APP_DOMAIN
KOKORO_LOG_LEVEL=INFO
USER_TIMEZONE=Asia/Hong_Kong
USER_PRIMARY_LANGUAGE=zh-TW

# Use the PostgreSQL service's private hostname and the secret password set on
# that service. PostgreSQL and the app must be in the same Zeabur project.
DATABASE_URL=postgresql+asyncpg://kokoro:CHANGE_ME_POSTGRES_PASSWORD@CHANGE_ME_POSTGRES_PRIVATE_HOST:5432/kokoro_link

# A public cloud deployment must require a login.
AUTH_ENABLED=true
JWT_SECRET=CHANGE_ME_NEW_STABLE_SECRET

# Retain the existing production value during the real data migration if the
# encrypted Admin provider configuration is to remain readable.
CONFIG_ENCRYPTION_KEY=CHANGE_ME_EXISTING_OR_NEW_PRODUCTION_SECRET

DEPLOYMENT_MODE=container
STORAGE_PROVIDER=http
STORAGE_URL=http://CHANGE_ME_STORAGE_PRIVATE_HOST:9000
STORAGE_KEY=CHANGE_ME_SHARED_STORAGE_SECRET

# Only set this when WhatsApp is enabled in the cloud project.
# WHATSAPP_SIDECAR_URL=http://CHANGE_ME_WHATSAPP_PRIVATE_HOST:32190
# WHATSAPP_SIDECAR_PORT=32190
# WHATSAPP_SIDECAR_API_TOKEN=CHANGE_ME_WHATSAPP_SECRET

# Optional one-time bootstrap for a new authenticated cloud deployment.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first successful sign-in.
# BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME_PASSWORD
